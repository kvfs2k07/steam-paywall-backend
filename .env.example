# Webhook
API_URL="https://store.xyz/api/payments/steamhook"
API_DEV_URL="https://dev.store.xyz/api/payments/steamhook"

# Security — shared HMAC secret between this bot and the store API
SHARED_SECRET=replace-with-64-char-hex-secret

# Server
PORT=3000

# Minimum item value to accept in trades (USD)
MIN_ITEM_PRICE=0.15

# Steam — obtain a refresh token via steam-session
STEAM_REFRESH_TOKEN=replace-with-steam-refresh-token

# Steam Web API Key (optional — auto-extracted from web session if empty)
STEAM_API_KEY=

# Set to true to point at API_DEV_URL instead of API_URL
DEV=false
